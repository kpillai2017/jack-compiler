// Array.jack
// Example demonstrating array operations

class Array {
    function void main() {
        var Array arr;
        var int i, sum;
        
        let arr = Array.new(5);
        let arr[0] = 10;
        let arr[1] = 20;
        let arr[2] = 30;
        
        let i = 0;
        let sum = 0;
        
        while (i < 3) {
            let sum = sum + arr[i];
            let i = i + 1;
        }
        
        do Output.printString("Array sum: ");
        do Output.printInt(sum);
        do Output.println();
        
        do arr.dispose();
        
        return;
    }
}
