# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.py text eol=lf
*.g4 text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf

# Jack language files
*.jack text eol=lf
*.vm text eol=lf

# Binary files
*.jar binary
*.pyc binary
*.so binary
*.egg-info/ binary

# HTML/XML
*.html text eol=lf
*.xml text eol=lf
*.interp text eol=lf
*.tokens text eol=lf
